# SafePush — Git line-ending normalization
# Ensures consistent LF line endings in the repository regardless of OS.
# Windows checkouts will still use CRLF locally if core.autocrlf=true,
# but the repository always stores LF.

# Default: normalize all text files to LF in the repo
* text=auto eol=lf

# Explicitly text files
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.sh    text eol=lf
*.env*  text eol=lf
*.txt   text eol=lf
*.rst   text eol=lf

# Binary files — never modify
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip   binary
*.tar   binary
*.gz    binary
