# SafePush Environment Configuration
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control.

# ===========================================================================
# SafePush Core Settings
# ===========================================================================

# Default log level for the SafePush logger (DEBUG, INFO, WARNING, ERROR, CRITICAL)
SAFEPUSH_LOG_LEVEL=WARNING

# ===========================================================================
# Future Integration Settings (not active in this release)
# ===========================================================================

# GitHub API token (for future GitHub Action integration)
# GITHUB_TOKEN=

# OpenAI API key (for future AI scanner integration)
# OPENAI_API_KEY=

# Semgrep App Token (for future Semgrep cloud integration)
# SEMGREP_APP_TOKEN=
